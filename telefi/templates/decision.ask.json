{
  "$id": "telefi.template.decision.ask",
  "title": "Owner decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "question",
    "options"
  ],
  "properties": {
    "question": {
      "type": "string",
      "maxLength": 200
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 16,
            "pattern": "^[a-z0-9_*-]+$"
          },
          "label": {
            "type": "string",
            "maxLength": 40
          },
          "implication": {
            "type": "string",
            "maxLength": 160
          },
          "recommended": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
