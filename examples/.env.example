# Copy to .env (never commit it) and load it into your shell or service environment.
# Required for Telegram:
TELEGRAM_BOT_TOKEN=123456789:replace-with-the-token-from-BotFather
TELEGRAM_CHAT_ID=123456789
# Optional:
TELEFI_HOME=~/.telefi          # config + records (hub.json, outbox.jsonl, ...)
TELEFI_SPOOL=~/.telefi/spool   # the drop folder producers write to
TELEFI_LIVE=0                  # 1 = also run the live Telegram test in the test suite
